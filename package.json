{
  "name": "stephanies-pi-setup",
  "version": "1.0.0",
  "description": "Stephanie's personal Pi extensions, skills, prompts, and theme.",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent"
  ],
  "scripts": {
    "check": "effect-tsgo patch && tsc --noEmit -p tsconfig.json",
    "format:check": "prettier --check README.md SETUP.md SECURITY.md NOTICE.md package.json tsconfig.json settings.example.json",
    "test": "node --test --experimental-strip-types extensions/claude-agents/*.test.ts && vitest run extensions/file-search/index.spec.ts"
  },
  "pi": {
    "extensions": [
      "./extensions/claude-agents/index.ts",
      "./extensions/file-search/index.ts"
    ],
    "skills": [
      "./skills/claude-agent-sdk"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes"
    ]
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.218",
    "@effect/platform-node": "4.0.0-beta.101",
    "@effect/platform-node-shared": "4.0.0-beta.101",
    "effect": "4.0.0-beta.101",
    "pi-subagents": "0.40.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@earendil-works/pi-tui": "0.84.1",
    "@effect/tsgo": "0.24.3",
    "@effect/vitest": "4.0.0-beta.101",
    "@types/node": "24.10.0",
    "prettier": "3.9.6",
    "typebox": "1.3.7",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
